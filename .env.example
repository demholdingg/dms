# Copy to .env.local for `npm run dev`, or to .env for Docker Compose.
PAPERLESS_URL=http://webserver:8000
PAPERLESS_PUBLIC_URL=http://localhost:8000
PAPERLESS_SERVICE_TOKEN=replace-with-paperless-service-token
PAPERLESS_HOST_HEADER=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_URL=http://localhost:3000
PORTAL_PORT=3000
PAPERLESS_NETWORK=paperless_default
SESSION_HOURS=8
COOKIE_SECURE=false
DISPLAY_TZ=Asia/Jakarta
SEARCH_MIN_CHARS=3
MAX_GRANT_ATTEMPTS=10
AUDIT_URL=http://audit:8080
AUDIT_API_KEY=
AUDIT_VIEWERS=
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=approval@localhost

# Only needed when using the optional Cloudflare Tunnel in src/compose.yml.
TUNNEL_TOKEN=
